# =======================================================================
# CLASH OF BYTES: ENVIRONMENT CONFIGURATION TEMPLATE
# Permanent Database Architecture: Unified Supabase Cloud PostgreSQL
# Shared by BOTH the Web Arena Platform and the Java Swing Desktop App
# =======================================================================
# Instructions:
# 1. Copy this file to '.env' in your local project root:
#    cp .env.example .env
# 2. Fill in your project-specific credentials from your Supabase dashboard.
# 3. NEVER commit your actual '.env' file or database passwords to Git!
# =======================================================================

# -----------------------------------------------------------------------
# 1. Primary Cloud Database: Supabase PostgreSQL (Managed Cloud Instance)
# -----------------------------------------------------------------------
# Direct JDBC Connection URL (Supavisor Transaction Pooler on Port 6543 recommended):
SUPABASE_DB_URL=jdbc:postgresql://<PROJECT_REF>.pooler.supabase.com:6543/postgres?sslmode=require

# Discrete Connection Parameters (Read by Backend & Java JDBC Factory):
SUPABASE_DB_HOST=<PROJECT_REF>.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.<PROJECT_REF>
SUPABASE_DB_PASSWORD=your_supabase_db_password_here
SUPABASE_SSL=require

# -----------------------------------------------------------------------
# 2. Supabase Client & REST API Settings (Frontend & Web Client)
# -----------------------------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co):
SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Public Anonymous API Key (Safe for frontend client; guarded by Row Level Security):
SUPABASE_ANON_KEY=your_supabase_public_anon_key_here

# -----------------------------------------------------------------------
# 3. Local Development Database (Alternative: Local Docker PostgreSQL)
# -----------------------------------------------------------------------
# Used when running a local PostgreSQL container or local Supabase CLI:
# (Leave as localhost when developing offline; overrides Supabase if enabled)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clash_of_bytes
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# -----------------------------------------------------------------------
# 4. Backend Application & Security Settings (StandaloneWebServer / Spring)
# -----------------------------------------------------------------------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=YourSuperSecretKeyWithAtLeast256BitsOfEntropyForProductionClashOfBytes2026
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------
# 5. Frontend Client & Public Domain Settings
# -----------------------------------------------------------------------
VITE_API_URL=http://localhost:8080/api
PORT=3000
PUBLIC_DOMAIN=clashofbytes.io
