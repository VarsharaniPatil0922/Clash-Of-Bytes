# =======================================================================
# CLASH OF BYTES: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env and configure secret keys before running
# =======================================================================

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clash_of_bytes
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Backend Settings
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=YourSuperSecretKeyWithAtLeast256BitsOfEntropyForProductionClashOfBytes2026
JWT_EXPIRATION_MS=86400000

# Frontend Settings
VITE_API_URL=http://localhost:8080/api
PORT=3000

# Public Domain / Hosting Settings (e.g. Render / Railway / AWS / Netlify)
PUBLIC_DOMAIN=clashofbytes.io
